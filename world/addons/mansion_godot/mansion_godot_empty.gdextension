[configuration]

# Entry symbol that Godot calls to initialize the extension
entry_symbol = "GDExtensionInit"

# Version info
version = "1.0"
compatibility_minimum = "4.1"

[libraries]

# Linux paths (absolute)
linux.x86_64.release = "/home/deck/code/mansion-desktop/world/addons/mansion_godot/libmansion_godot_empty.so"
linux.x86_64.debug = "/home/deck/code/mansion-desktop/world/addons/mansion_godot/libmansion_godot_empty.so"
