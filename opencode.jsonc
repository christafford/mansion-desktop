{
  "$schema": "https://opencode.ai/config.json",
  // Project permissions for autonomous runs (see docs/OPENCODE-AUTOCONTINUE.md).
  // The auto-continue plugin stops a run on any permission prompt or question,
  // so everything an unattended run legitimately needs is allowed here and the
  // few destructive or outward-facing commands are denied outright.
  "permission": {
    "read": "allow",
    "edit": "allow",
    "task": "allow",
    "question": "deny",
    "external_directory": "deny",
    "bash": {
      "*": "allow",
      "sudo *": "deny",
      "su *": "deny",
      "git push *": "deny",
      "git push": "deny",
      "git reset --hard*": "deny",
      "git clean *": "deny",
      "git checkout -- *": "deny",
      "git restore .": "deny",
      "git rebase *": "deny",
      "git commit --amend*": "deny",
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "rm -r *": "deny",
      "pacman *": "deny",
      "npm install -g *": "deny"
    }
  }
}
