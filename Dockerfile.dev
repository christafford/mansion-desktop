# Mansion Desktop development image (Arch Linux). Builds and runs the headless tests.
FROM archlinux

RUN pacman -Syu --noconfirm && pacman -S --noconfirm --needed \
    base-devel git meson ninja pkgconf \
    wayland wayland-protocols libxkbcommon mesa libx11 nodejs \
    weston \
    && pacman -Scc --noconfirm

WORKDIR /src
CMD ["sh", "-c", "meson setup build --buildtype=debug && meson compile -C build && meson test -C build --print-errorlogs"]
